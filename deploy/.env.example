# 知识库平台部署配置。复制为 .env 后修改，部署只需要看这一个文件。
# 标有【必改】的项必须修改；其余保持默认即可。

# ---------- 访问入口 ----------
# 浏览器和调用方访问平台的端口
EXPOSE_PORT=8200

# ---------- 向量模型（OpenAI 兼容接口）----------
# 【必改】公司网关上的向量接口地址和密钥
EMBEDDING_URL=https://aigate.jptoe.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ---------- 组件密码 ----------
# 【必改】各填一个随机字符串（只用字母、数字、下划线、连字符）
DB_PASSWORD=
REDIS_PASSWORD=
MINIO_ACCESS_KEY=kbplatform
MINIO_SECRET_KEY=

# ---------- 一起部署哪些基础组件 ----------
# 默认全部一起部署。要改用外部已有的组件，从这里去掉它的名字，
# 再到下面「外部组件地址」中取消注释并填写。
COMPOSE_PROFILES=postgres,redis,minio,milvus

# ---------- 外部组件地址（仅在不一起部署时填写）----------
# DB_HOST=
# DB_PORT=5432
# DB_USER=kb_platform
# DB_NAME=kb_platform
# REDIS_HOST=
# REDIS_PORT=6379
# MINIO_ENDPOINT=主机:端口
# MILVUS_URI=http://主机:19530
# MILVUS_TOKEN=

# ---------- 其他 ----------
# 登录有效期（小时）
TOKEN_EXPIRE_HOURS=12
# 单个文件大小上限（MB）；修改后需同步修改 nginx/default.conf 中的 client_max_body_size
UPLOAD_MAX_SIZE_MB=50
LOG_LEVEL=INFO
# 检索记录保留天数
RETRIEVAL_LOG_KEEP_DAYS=30
# 构建镜像时使用的 pip 源和 npm 源，内网有镜像源时改成内网地址
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org/

# ---------- 基础组件的镜像（一般不用改）----------
# 服务器不能访问公共镜像仓库、或要使用内部镜像仓库时，取消注释并改成可用的地址。
# 其中 MinIO 的镜像已从公共仓库下架，必须手工导入或改用内部仓库，见 README。
# POSTGRES_IMAGE=postgres:16-alpine
# REDIS_IMAGE=redis:7-alpine
# MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
# ETCD_IMAGE=quay.io/coreos/etcd:v3.5.16
# MILVUS_IMAGE=milvusdb/milvus:v2.6.27

# ---------- 基础组件在本机的调试端口（只监听 127.0.0.1）----------
DEV_POSTGRES_PORT=8201
DEV_REDIS_PORT=8202
DEV_MINIO_PORT=8203
DEV_MINIO_CONSOLE_PORT=8204
DEV_MILVUS_PORT=8205
