# 不走 Docker、用 manage.sh 单独启动接口进程和任务进程时使用。复制为 .env 后修改。
# 一键部署请使用 deploy/.env，不需要这个文件。
# 这里的组件地址对应 deploy/docker-compose.yaml 在本机开放的调试端口，
# 密码与 deploy/.env 中的保持一致。

API_HOST=127.0.0.1
API_PORT=8210
LOG_LEVEL=INFO

DB_HOST=127.0.0.1
DB_PORT=8201
DB_USER=kb_platform
DB_PASSWORD=
DB_NAME=kb_platform

REDIS_HOST=127.0.0.1
REDIS_PORT=8202
REDIS_PASSWORD=

MINIO_ENDPOINT=127.0.0.1:8203
MINIO_ACCESS_KEY=kbplatform
MINIO_SECRET_KEY=
MINIO_BUCKET=kb-platform

MILVUS_URI=http://127.0.0.1:8205
MILVUS_TOKEN=

# 向量模型（OpenAI 兼容接口）
EMBEDDING_URL=https://aigate.jptoe.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

TOKEN_EXPIRE_HOURS=12
UPLOAD_MAX_SIZE_MB=50
